ENABLE_DOCS=true
LLM_GATEWAY_ENVIRONMENT=dev
LLM_GATEWAY_LOG_LEVEL=INFO
LLM_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
LLM_GATEWAY_ADMIN_API_KEY=replace-with-admin-token
LLM_GATEWAY_METRICS_API_KEY=replace-with-metrics-token
LLM_GATEWAY_MAX_REQUEST_BODY_BYTES=1048576
LLM_GATEWAY_UVICORN_WORKERS=2
LLM_GATEWAY_REQUIRE_PROVIDER_API_KEYS=false
LLM_GATEWAY_PROVIDER_PREFERENCE=openai,anthropic,gemini
LLM_GATEWAY_CLASSIFICATION_PROVIDER_PREFERENCE=openai,gemini,anthropic
LLM_GATEWAY_LONG_FORM_GENERATION_PROVIDER_PREFERENCE=anthropic,openai,gemini
LLM_GATEWAY_LATENCY_SENSITIVE_REQUEST_CLASSES=classification
LLM_GATEWAY_INTERACTIVE_REQUEST_CLASSES=classification
LLM_GATEWAY_DEFERRABLE_REQUEST_CLASSES=long_form_generation
LLM_GATEWAY_OPENAI_API_KEY=replace-with-openai-key
LLM_GATEWAY_OPENAI_API_BASE=
LLM_GATEWAY_ANTHROPIC_API_KEY=replace-with-anthropic-key
LLM_GATEWAY_GEMINI_API_KEY=replace-with-gemini-key
LLM_GATEWAY_DEFAULT_MODEL=gpt-4o-mini
LLM_GATEWAY_CHEAP_MODEL=gpt-4o-mini
LLM_GATEWAY_EASY_REQUEST_CLASSES=classification
LLM_GATEWAY_EASY_PROMPT_MAX_WORDS=80
LLM_GATEWAY_OPENAI_MODEL=gpt-4o-mini
LLM_GATEWAY_ANTHROPIC_MODEL=anthropic/claude-3-5-haiku-latest
LLM_GATEWAY_GEMINI_MODEL=gemini/gemini-1.5-flash
LLM_GATEWAY_REDIS_URL=redis://localhost:6379/0
LLM_GATEWAY_HEALTH_WINDOW_SECONDS=300
LLM_GATEWAY_CIRCUIT_MIN_SAMPLES=5
LLM_GATEWAY_CIRCUIT_ERROR_RATE_THRESHOLD=0.5
LLM_GATEWAY_CIRCUIT_P95_LATENCY_THRESHOLD_SECONDS=10.0
LLM_GATEWAY_CIRCUIT_RESET_SECONDS=30.0
LLM_GATEWAY_CIRCUIT_HALF_OPEN_PROBE_RATE=0.05
LLM_GATEWAY_HEDGE_DELAY_SECONDS=0.75
LLM_GATEWAY_QUEUE_NAME=llm_gateway:queue:ready
LLM_GATEWAY_QUEUE_DELAYED_NAME=llm_gateway:queue:delayed
LLM_GATEWAY_QUEUE_IDEMPOTENCY_PREFIX=llm_gateway:queue:idempotency

LLM_GATEWAY_QUEUE_MAX_BACKOFF_SECONDS=30.0
LLM_GATEWAY_QUEUE_JITTER_SECONDS=0.25
LLM_GATEWAY_QUEUE_MAX_ATTEMPTS=5
LLM_GATEWAY_QUEUE_WORKER_ENABLED=false
LLM_GATEWAY_ESTIMATED_COST_PER_1K_TOKENS=0.001
LLM_GATEWAY_SEMANTIC_CACHE_ENABLED=true
LLM_GATEWAY_SEMANTIC_CACHE_KEY_PREFIX=llm_gateway:semantic_cache
LLM_GATEWAY_SEMANTIC_CACHE_TTL_SECONDS=3600
